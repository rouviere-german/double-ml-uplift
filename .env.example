# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=double-ml-uplift
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run double-ml-uplift generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Role-based access. HS256 key shared with whatever mints analyst/operator tokens.
# Leave empty locally: every role-protected route then fails closed.
APP_JWT_SECRET=
APP_JWT_ISSUER=double-ml-uplift
APP_JWT_AUDIENCE=double-ml-uplift-api
APP_JWT_MAX_LIFETIME_SECONDS=3600

# HMAC key for pseudonymising customer ids in responses, logs and exports.
# The service refuses to start without it.
APP_CUSTOMER_ID_PEPPER=
APP_MIN_COHORT_SIZE=50

# Per-request caps.
APP_MAX_UPLOAD_ROWS=200000
APP_MAX_REQUEST_FOLDS=10
APP_MAX_REQUEST_BOOTSTRAP=2000
APP_MAX_SCORE_ROWS=5000

# Targeting release controls.
APP_FAIRNESS_MAX_DISPARITY=0.15
APP_APPROVAL_TTL_SECONDS=900

# Keys the cross-fitting fold hash. Empty means the bundled public default, which is fine for
# reproducibility and gives no unpredictability. Set a per-environment secret when someone who
# can choose customer ids must not be able to steer them into a chosen fold.
APP_FOLD_SALT=

APP_DATA_DIR=var
# Every successful estimation is published to the model registry under APP_DATA_DIR; only this
# many of the newest runs are kept, so the directory cannot grow by one bundle per request.
APP_REGISTRY_KEEP_VERSIONS=20
